HOLESKY_USDC_CONTRACT=0x449cde79f489e2ae32e6314d8d966ca64e040409
HOLESKY_USDT_CONTRACT=0x87350147a24099bf1e7e677576f01c1415857c75

# Withdrawal Limits
MAX_DAILY_WITHDRAWAL=10000
MAX_SINGLE_WITHDRAWAL=1000
AUTO_APPROVAL_THRESHOLD=500

# Notifications
WEBHOOK_URL=your_webhook_url_for_notifications
ADMIN_EMAIL=admin@yourdomain.com

# External API Keys
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Development/Production Mode
NODE_ENV=development

# Frontend Configuration
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
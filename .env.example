# Private key for deployment (DO NOT COMMIT THE REAL .env FILE)
PRIVATE_KEY=your_private_key_here

# RPC URLs for testnets
HOLESKY_RPC_URL=https://ethereum-holesky.blockpi.network/v1/rpc/public
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Gas reporting
REPORT_GAS=true

# Admin Security Settings (CRITICAL - KEEP SECURE)
# List of admin wallet addresses (comma separated, no spaces)
ADMIN_WALLETS=0x4c6165286739696849fb3e77a16b0639d762c5b6,0xanotherAdminWallet
# Strong secret key for encryption and security operations
ADMIN_SECRET_KEY=your_super_secret_admin_key_here
# Session secret for secure session management
SESSION_SECRET=your_session_secret_key_here
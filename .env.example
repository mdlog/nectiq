# NECTIQ PLATFORM ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=your_postgresql_connection_string_here

# Session Security
SESSION_SECRET=your_super_secret_session_key_here_minimum_32_characters

# Admin Configuration (CRITICAL SECURITY)
ADMIN_WALLET_ADDRESSES=0xYourAdminWalletAddress1,0xYourAdminWalletAddress2
ADMIN_DEPOSIT_WALLET=0xYourMainAdminDepositWalletAddress
ADMIN_PRIVATE_KEY=your_admin_private_key_for_withdrawals
ADMIN_IP_WHITELIST=127.0.0.1,::1,your.admin.ip.address
ADMIN_EMAIL=admin@yourdomain.com

# Blockchain RPC URLs
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
BSC_RPC_URL=https://bsc-dataseed.binance.org/
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.public.blastapi.io
HOLESKY_RPC_URL=https://ethereum-holesky-rpc.publicnode.com

# Smart Contract Addresses (CRITICAL SECURITY)
# Ethereum Mainnet
ETHEREUM_USDC_CONTRACT=0xA0b86a33E6441d5d867b7a067e26fA9Cb9C48B07
ETHEREUM_USDT_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7

# Base Network
BASE_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BASE_USDT_CONTRACT=0xfde4C96c8593536E31F229EA8f37b2ADa2699bb2

# BSC Network
BSC_USDC_CONTRACT=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955

# Optimism Network
OPTIMISM_USDC_CONTRACT=0x0b2C639c533813f4Aa9D7837CAf62653d097Ff85
OPTIMISM_USDT_CONTRACT=0x94b008aA00579c1307B0EF2c499aD98a8ce58e58

# Arbitrum Network
ARBITRUM_USDC_CONTRACT=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
ARBITRUM_USDT_CONTRACT=0xFd086bC7CD5C481DCC9C85ebE478A1C0b69FCbb9

# Sepolia Testnet (fallback configured in code)
SEPOLIA_USDC_CONTRACT=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
SEPOLIA_USDT_CONTRACT=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238


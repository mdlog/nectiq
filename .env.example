# ============================================================
# NECTIQ PLATFORM - .env.example FILE  
# ============================================================
# Copy this file to .env and fill in your values
# ============================================================

# Server Configuration
PORT=5003
NODE_ENV=production

# Database (PostgreSQL/Neon)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Blockchain API Keys (Get at https://etherscan.io/register)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Polygon API Key (Get at https://polygonscan.com/register)
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Optional: Other blockchain explorers
# BSCSCAN_API_KEY=your_bscscan_key
# BASESCAN_API_KEY=your_basescan_key  
# ARBISCAN_API_KEY=your_arbiscan_key
# OPTIMISM_API_KEY=your_optimism_key

# Wallet Configuration
ADMIN_WALLET_ADDRESSES=0x_Your_Admin_Wallet_Address
DEPOSIT_WALLET_ADDRESS=0x_Your_Deposit_Wallet_Address

# Session Secret (Generate with: openssl rand -base64 32)
SESSION_SECRET=change_this_to_a_random_secret

# Smart Contract Deployment
# Private key for deploying contracts (NO 0x PREFIX)
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_without_0x_prefix

# Backend Signer for Transactions
BACKEND_SIGNER_ADDRESS=0x_Your_Backend_Signer_Address
BACKEND_SIGNER_PRIVATE_KEY=your_backend_signer_private_key_without_0x_prefix

# Smart Contract Addresses
# NectiqVault contract address on Polygon Amoy
VAULT_CONTRACT_ADDRESS=0x_Your_Vault_Contract_Address
VITE_VAULT_CONTRACT_ADDRESS=0x_Your_Vault_Contract_Address

# Optional: Firebase (for social auth)
# VITE_FIREBASE_API_KEY=your_firebase_key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id

# Optional: WalletConnect
# VITE_WALLETCONNECT_PROJECT_ID=your_project_id

# Optional: Monitoring intervals (milliseconds)
# DEPOSIT_CHECK_INTERVAL=60000
# WITHDRAWAL_CHECK_INTERVAL=120000

# Multi-Token Vault Contract (Polygon Amoy)
MULTI_TOKEN_VAULT_ADDRESS=your_multi_token_vault_contract_address
VITE_MULTI_TOKEN_VAULT_ADDRESS=your_multi_token_vault_contract_address
AMOY_WETH_ADDRESS=0x52eF3d68BaB452a294342DC3e5f464d7f610f72E
AMOY_USDC_ADDRESS=0x8B0180f2101c8260d49339abfEe87927412494B4
AMOY_LINK_ADDRESS=0x0fd9E8d3Af1aAeE056eb9e902c3A762a667b1904
VITE_AMOY_WETH_ADDRESS=0x52eF3d68BaB452a294342DC3e5f464d7f610f72E
VITE_AMOY_USDC_ADDRESS=0x8B0180f2101c8260d49339abfEe87927412494B4
VITE_AMOY_LINK_ADDRESS=0x0fd9E8d3Af1aAeE056eb9e902c3A762a667b1904

# ==========================================
# SAFE ENVIRONMENT CONFIGURATION
# ==========================================
# This file contains ONLY non-sensitive configuration values
# All sensitive data has been moved to secure Replit Secrets

# Environment (safe to keep here)
NODE_ENV=production

# Server Configuration (safe to keep here)
PORT=5000
HOST=0.0.0.0

# Public Blockchain RPC URLs (safe to keep here - these are public endpoints)
SEPOLIA_RPC_URL=https://eth-sepolia.public.blastapi.io
ETHEREUM_RPC_URL=https://eth-mainnet.public.blastapi.io
BASE_RPC_URL=https://mainnet.base.org
BSC_RPC_URL=https://bsc-dataseed.binance.org/
OPTIMISM_RPC_URL=https://mainnet.optimism.io
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
HOLESKY_RPC_URL=https://ethereum-holesky-rpc.publicnode.com

# Withdrawal Limits (safe configuration values)
MAX_DAILY_WITHDRAWAL=10000
MAX_SINGLE_WITHDRAWAL=1000
AUTO_APPROVAL_THRESHOLD=500

# ==========================================
# SECURITY NOTICE
# ==========================================
# The following sensitive data has been MOVED to secure Replit Secrets:
#
# - DATABASE_URL (database connection string)
# - SESSION_SECRET (session management secret)
# - ADMIN_WALLET_ADDRESSES (admin wallet addresses)
# - ADMIN_DEPOSIT_WALLET (primary admin wallet)
# - ADMIN_IP_WHITELIST (admin IP addresses)
# - ETHERSCAN_API_KEY (blockchain verification)
# - VITE_WALLETCONNECT_PROJECT_ID (wallet integration)
# - VITE_DYNAMIC_ENVIRONMENT_ID (authentication)
# - ADMIN_PRIVATE_KEY (automated withdrawals)
#
# These values are now safely stored in Replit's encrypted secrets
# and are automatically loaded as environment variables.
# ==========================================